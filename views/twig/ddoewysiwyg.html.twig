<style type="text/css">
    @import url('{{ oViewConf.getModuleUrl('ddoewysiwyg','out/src/css/font-awesome.min.css') }}');
    @import url('{{ oViewConf.getModuleUrl('ddoewysiwyg','out/src/css/ddoesummernote.min.css') }}');
    @import url('{{ oViewConf.getModuleUrl('ddoewysiwyg','out/src/css/summernote.min.css') }}');

    #ddoew {
        position: relative;
    }
</style>

<div class="ddoe-wysiwyg" id="ddoew">
    <div class="ddoe-wysiwyg-editor">
        {% set sEditorWidth = '100%' %}
        {% if iEditorWidth %}{% set sEditorWidth = iEditorWidth %}{% endif %}

        {% set sEditorHeight = '300px' %}
        {% if iEditorHeight %}{% set sEditorHeight = iEditorHeight %}{% endif %}

        <textarea {% if blTextEditorDisabled  %}disabled {% endif %}id="editor_{{ sEditorField }}"
                  name="{{ sEditorField }}"
                  style="width: {{ sEditorWidth }}; height: {{ sEditorHeight }};"
                  data-lang="{{ langabbr }}"
                  data-ssl="{{ isSSL }}">{{ sEditorValue|escape("html") }}</textarea>
    </div>
</div>

{{ script({ include: oViewConf.getModuleUrl('ddoewysiwyg', 'out/src/js/jquery.min.js'), priority: 1, dynamic: __oxid_include_dynamic }) }}
{{ script({ include: oViewConf.getModuleUrl('ddoewysiwyg', 'out/src/js/jquery-ui.min.js'), priority: 1, dynamic: __oxid_include_dynamic }) }}
{{ script({ include: oViewConf.getModuleUrl('ddoewysiwyg', 'out/src/js/bootstrap.bundle.min.js'), priority: 1, dynamic: __oxid_include_dynamic }) }}
{{ script({ include: oViewConf.getModuleUrl('ddoewysiwyg', 'out/src/js/summernote/summernote.min.js'), priority: 1, dynamic: __oxid_include_dynamic }) }}
{% if langabbr == 'de' %}
    {{ script({ include: oViewConf.getModuleUrl('ddoewysiwyg', 'out/src/js/summernote/summernote-de-DE.min.js'), priority: 1, dynamic: __oxid_include_dynamic }) }}
{% endif %}

<script type="module">
    top.basefrm.mediaUrls = {{ contentMediaUrls|json_encode|raw }};

    import { autoInitializeSummernote } from "{{ oViewConf.formJsFileUrl(oViewConf.getModuleUrl('ddoewysiwyg', 'out/src/js/summernote/ddoesummernote.min.js')) }}";

    top.basefrm.OverlayStyles = '{{ oViewConf.formJsFileUrl(oViewConf.getModuleUrl('ddoewysiwyg', 'out/src/css/overlay.min.css')) }}';
    top.basefrm.editorControllerUrl = '{{ oViewConf.getSelfLink()|cat('cl=ddoemedia_wrapper&overlay=1')|replace({'&amp;':'&'})|raw }}';

    document.addEventListener("DOMContentLoaded", function() {
        const baseIframe = top.basefrm.document;
        const moduleScript = baseIframe.createElement("script");
        moduleScript.type = "module";
        moduleScript.innerHTML = `
            (async () => {
                try {
                    await import("{{ oViewConf.getSelfLink()|cat('cl=ddoelangjs')|replace({'&amp;':'&'})|raw }}");
                    await import("{{ oViewConf.formJsFileUrl(oViewConf.getModuleUrl('ddoewysiwyg', 'out/src/js/jquery.min.js')) }}");

                    const { OverlayInstance } = await import("{{ oViewConf.formJsFileUrl(oViewConf.getModuleUrl('ddoewysiwyg', 'out/src/js/summernote/overlay.min.js')) }}");
                    window.OverlayInstance = OverlayInstance;
                } catch (error) {
                    console.error("Failed to load overlay script:", error);
                }
            })();
        `;
        baseIframe.head.appendChild(moduleScript);
        autoInitializeSummernote();
    });
</script>
